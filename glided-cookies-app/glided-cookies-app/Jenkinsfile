pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo '=== Stage 1: Checkout GitHub ==='
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                echo '=== Stage 2: Install Dependencies ==='

                dir('glided-cookies-app/glided-cookies-app/frontend') {
                    bat 'npm install --include=dev --no-audit --no-fund'
                }

                dir('glided-cookies-app/glided-cookies-app/backend') {
                    bat 'npm install --no-audit --no-fund'
                }
            }
        }

        stage('Syntax Check') {
            steps {
                echo '=== Stage 3: Check Backend Syntax ==='

                dir('glided-cookies-app/glided-cookies-app/backend') {
                    bat 'node --check server.js'
                }
            }
        }

        stage('Production Build') {
            steps {
                echo '=== Stage 4: Build Frontend ==='

                dir('glided-cookies-app/glided-cookies-app/frontend') {
                    bat 'npm run build'
                }
            }
        }

        stage('Docker Deploy') {
            steps {
                echo '=== Stage 5: Build and Deploy with Docker ==='

                dir('glided-cookies-app/glided-cookies-app') {
                    bat '"C:\\Users\\manth\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker-compose.exe" version'

                    bat '"C:\\Users\\manth\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker-compose.exe" up -d --build

                    bat '"C:\\Users\\manth\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker-compose.exe" ps'
                }
            }
        }

        stage('Deployment URL') {
            steps {
                echo '=== Stage 6: Deployment Details ==='
                echo 'Deployment successful!'
                echo 'Home Page: http://localhost'
                echo 'Admin Login: http://localhost/admin/login'
                echo 'Admin Dashboard: http://localhost/admin'
                echo 'Backend URL: http://localhost:5000'
            }
        }
    }

    post {
        success {
            echo 'Pipeline finished successfully!'
            echo 'Home Page: http://localhost'
            echo 'Admin Login: http://localhost/admin/login'
            echo 'Admin Dashboard: http://localhost/admin'
            echo 'Backend URL: http://localhost:5000'
        }

        failure {
            echo 'Pipeline failed. Check Console Output.'
        }
    }
}

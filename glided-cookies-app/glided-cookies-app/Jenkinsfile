pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo '=== Stage 1: Checking out repository ==='
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                echo '=== Stage 2: Installing Dependencies ==='

                dir('glided-cookies-app/glided-cookies-app/frontend') {
                    bat 'npm install --include=dev --no-audit --no-fund'
                    bat 'npm exec vite -- --version'
                }

                dir('glided-cookies-app/glided-cookies-app/backend') {
                    bat 'npm install --no-audit --no-fund'
                }
            }
        }

        stage('Lint & Syntax Check') {
            steps {
                echo '=== Stage 3: Checking Backend Syntax ==='

                dir('glided-cookies-app/glided-cookies-app/backend') {
                    bat 'node --check server.js'
                }
            }
        }

        stage('Production Build') {
            steps {
                echo '=== Stage 4: Building Frontend ==='

                dir('glided-cookies-app/glided-cookies-app/frontend') {
                    bat 'npm run build'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo '=== Stage 5: Deployment Preparation ==='
                echo 'Frontend build artifacts verified in frontend/dist/'
            }
        }
    }

    post {
        success {
            echo 'Pipeline finished successfully!'
        }

        failure {
            echo 'Pipeline failed.'
        }
    }
}
